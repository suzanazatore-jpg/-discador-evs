# Chaves já existentes no projeto Discador EVS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=seu_api_key_secret
TWILIO_PHONE_NUMBER=+5584999999999
OPENAI_API_KEY=sk-proj-xxxxxxxx

# Domínio público deste serviço, sem https:// e sem barra final
TWILIO_VOICE_PUBLIC_DOMAIN=ana-voz.seudominio.com
PORT=8000

# Proteções. O teste só pode ligar para os números desta lista.
VOICE_SERVICE_SECRET=gere_um_segredo_longo_e_exclusivo
VOICE_AGENT_ENABLED=false
VOICE_AGENT_MODE=test
VOICE_AGENT_TEST_NUMBERS=+5584999999999
ALLOW_PRODUCTION_CALLS=false

# Retorno ao Discador EVS
DISCADOR_CALLBACK_URL=https://discador-evs.vercel.app/api/agente/resultado

# Modelos e voz
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_DELEGATION_MODEL=gpt-5.6-sol
OPENAI_VOICE=marin

# Calendly — evento oficial de 30 minutos
CALENDLY_ACCESS_TOKEN=seu_token_pessoal_do_calendly
CALENDLY_SCHEDULING_URL=https://calendly.com/suzanazatorreoficial/30min
CALENDLY_EVENT_TYPE_SLUG=30min
# Opcional: use o URI abaixo para evitar a descoberta automática pelo slug.
# CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/UUID
AGENDA_TIMEZONE=America/Sao_Paulo
DIAGNOSTICO_DURACAO_MINUTOS=30
AGENDA_ANTECEDENCIA_MINUTOS=120
