# ===== Twilio =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token_do_twilio
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=seu_api_key_secret_aqui
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Seu numero verificado, formato E.164:
TWILIO_CALLER_ID=+5585999998888

# ===== Supabase =====
SUPABASE_URL=https://lkqwxhrnsldwfrwcaxye.supabase.co
SUPABASE_SERVICE_ROLE_KEY=seu_service_role_key_aqui

# ===== Base Geral - Discador EVS =====
# URL do Web App do arquivo apps-script/DiscadorEVS_BaseGeral_Endpoint.gs
BASE_GERAL_APPS_SCRIPT_URL=https://script.google.com/macros/s/seu_deployment_id/exec
# Deve ser exatamente o mesmo token da propriedade DISCADOR_API_TOKEN no Apps Script.
BASE_GERAL_APPS_SCRIPT_TOKEN=gere_um_token_longo_e_aleatorio
# Deixe true para não expor dados por fallback no Supabase quando a Base_Geral falhar.
BASE_GERAL_REQUIRED=true

# ===== Acesso ao painel =====
# Defina valores fortes na Vercel. Nunca compartilhe a senha no código.
DISCADOR_LOGIN=seu_usuario
DISCADOR_SENHA=defina_uma_senha_forte
DISCADOR_AUTH_SECRET=gere_um_segredo_com_pelo_menos_32_caracteres
